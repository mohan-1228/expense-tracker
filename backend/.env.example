# Copy this to .env and fill in real values. Never commit the real .env.

PORT=5001
DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker_dev
JWT_SECRET=generate-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API,
# e.g. https://app.example.com,https://www.app.example.com
CORS_ORIGIN=http://localhost:5173

# Used by the Bedrock integration (weekly summary + Penny chat).
# Locally this is picked up from your AWS CLI credentials automatically -
# only needed here if the deploy target doesn't have an IAM role attached.
AWS_REGION=us-east-1
