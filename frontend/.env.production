# Read by Vite automatically when running `npm run build` (production
# mode by default). Unlike backend/.env, this is safe to commit - it's
# not a secret, it ends up readable in the built JS bundle regardless.
#
# Fill this in once the backend actually has a real address (EC2 public
# IP/DNS, or your real domain once CloudFront is in front of it).
VITE_API_URL=https://CHANGE-ME.example.com
