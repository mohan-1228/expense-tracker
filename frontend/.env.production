# Read by Vite automatically when running `npm run build` (production
# mode by default). Unlike backend/.env, this is safe to commit - it's
# not a secret, it ends up readable in the built JS bundle regardless.
#
# Interim value: the EC2 instance's Elastic IP (fixed, survives
# stop/start). Plain HTTP, no TLS yet - fine for now, but replace this
# with a real domain + HTTPS before pointing friends at it, since
# traffic (including login passwords) is unencrypted on this address.
VITE_API_URL=http://100.27.66.233:5001/api
