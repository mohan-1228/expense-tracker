# Read by Vite automatically when running `npm run build` (production
# mode by default). Unlike backend/.env, this is safe to commit - it's
# not a secret, it ends up readable in the built JS bundle regardless.
#
# Relative, not absolute: CloudFront serves this frontend AND routes
# /api/* to the EC2 backend from the same domain, so the browser's
# own origin is always correct. This means the bundle never needs
# rebuilding if the CloudFront domain or a future custom domain
# changes - no backend address is baked in at all.
VITE_API_URL=/api
